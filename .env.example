# Copy to .env and fill in.

# Serve the API from MSW static mocks (src/mocks) instead of a real backend: enabled | disabled
VITE_API_MOCKING=enabled

# Backend origin, used when mocking is disabled
VITE_API_BASE_URL=http://localhost:5173

# Google Gemini key for AI product descriptions
VITE_GEMINI_API_KEY=
